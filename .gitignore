# =============================================================================
# NutriWise AI – .gitignore
# =============================================================================

# Environment variables – never commit real credentials
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.spec

# Virtual environments
venv/
.venv/
env/
ENV/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# Distribution / packaging
*.whl
*.tar.gz
