# =============================================================================
# NutriWise AI – Environment Variables Template
# IBM watsonx.ai Credentials
# =============================================================================
# SETUP INSTRUCTIONS:
#   1. Copy this file and rename it to: .env
#   2. Replace ALL placeholder values below with your actual IBM Cloud credentials
#   3. Never commit the .env file to version control (it is listed in .gitignore)
# =============================================================================

# --------------------------------------------------
# IBM Cloud API Key
# How to get: https://cloud.ibm.com/iam/apikeys
# --------------------------------------------------
WATSONX_API_KEY=your_ibm_cloud_api_key_here

# --------------------------------------------------
# IBM watsonx.ai Project ID
# How to get: https://dataplatform.cloud.ibm.com
#             → Open your project → Manage → General → Project ID
# --------------------------------------------------
WATSONX_PROJECT_ID=your_watsonx_project_id_here

# --------------------------------------------------
# IBM watsonx.ai Regional Endpoint URL
# Choose the region closest to you:
#   us-south → https://us-south.ml.cloud.ibm.com
#   eu-de    → https://eu-de.ml.cloud.ibm.com
#   eu-gb    → https://eu-gb.ml.cloud.ibm.com
#   jp-tok   → https://jp-tok.ml.cloud.ibm.com
# --------------------------------------------------
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# --------------------------------------------------
# IBM watsonx.ai Model ID
# Recommended: ibm/granite-4-h-small
# Alternatives: meta-llama/llama-3-3-70b-instruct
#               mistralai/mistral-small-3-1-24b-instruct-2503
# --------------------------------------------------
WATSONX_MODEL_ID=ibm/granite-4-h-small

# --------------------------------------------------
# Flask Settings (optional – for local development)
# --------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
